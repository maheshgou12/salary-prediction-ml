# FairSalary AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==========================================
# DATABASE
# ==========================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# For local development with docker-compose:
DATABASE_URL=postgresql://fairuser:fairpass@localhost:5432/fairsalary

# For Supabase (production):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# JWT Algorithm
JWT_ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing rounds (bcrypt)
BCRYPT_ROUNDS=12

# ==========================================
# FRONTEND URL (for CORS)
# ==========================================
# Local development
FRONTEND_URL=http://localhost:5173

# Production (Vercel/Render):
# FRONTEND_URL=https://your-frontend.vercel.app

# ==========================================
# MODEL & ML
# ==========================================
# Path to trained model pipeline
MODEL_PATH=ml/models/best_model.joblib

# Path to model metadata
MODEL_METADATA_PATH=ml/models/metadata.json

# Model version
MODEL_VERSION=1.0.0

# ==========================================
# API SETTINGS
# ==========================================
# API Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_FAIRNESS_ANALYSIS=true
ENABLE_SHAP_EXPLANATIONS=true
ENABLE_SIMILAR_PROFILES=true
ENABLE_SALARY_RANGE=true

# ==========================================
# DEVELOPMENT
# ==========================================
DEBUG=true
LOG_LEVEL=INFO

# ==========================================
# EXTERNAL SERVICES (Optional)
# ==========================================
# Sentry DSN for error tracking
# SENTRY_DSN=

# Email service (for notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=